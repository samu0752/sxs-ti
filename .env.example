# Exporte estas variáveis antes de iniciar a aplicação.
# Gere uma chave com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# 1 ativa a demonstração pública isolada, com opção de restaurar exemplos.
DEMO_READ_ONLY=0

# 1 exige HTTPS para enviar o cookie. Use 0 somente para HTTP local.
SESSION_COOKIE_SECURE=0

# 1 carrega chamados fictícios quando o banco está vazio.
LOAD_SAMPLE_DATA=0

# Habilite apenas atrás do único proxy confiável do Render.
TRUST_RENDER_PROXY=0

# Bancos separados. Se omitidos, use instance/chamados.db e instance/demonstracao.db.
# TICKETS_DATABASE=/caminho/chamados.db
# DEMO_DATABASE=/caminho/demonstracao.db
